# Logto 本地部署配置模板
# 使用: cp .env.example .env 然后修改其中的值

# ===== Logto =====
# 镜像版本 tag
LOGTO_TAG=latest

# 宿主机端口映射（容器内固定监听 3001/3002，这里只改左边）
# 本机 3001/3002 被占用，用 4001/4002；改了端口记得同步改下面的 ENDPOINT
LOGTO_PORT=4001
LOGTO_ADMIN_PORT=4002

# 对外地址。本地部署保持 localhost；
# 加反向代理/部署到服务器后改成对外域名
LOGTO_ENDPOINT=http://localhost:4001
LOGTO_ADMIN_ENDPOINT=http://localhost:4002

# ===== 宿主机已有的 PostgreSQL =====
# 完整连接串，格式: postgres://用户:密码@地址:端口/库名
# host.docker.internal 指宿主机；库需事先建好且 OWNER 为该用户；
# 密码含 @ : / 等特殊字符需 URL 转义（如 @ 写成 %40）
DB_URL=postgres://user:password@host.docker.internal:5432/logto

# ===== 可选 =====
# 需要访问内网 webhook / SSO / 上游 OIDC 端点时填写，例如 10.0.0.0/8
# SSRF_ALLOWED_ADDRESSES=
